# ==============================================================================
# CIPA EXPERT · VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (CAPROVER / HETZNER VPS)
# ==============================================================================
# Configure estas variáveis no painel do CapRover:
# Apps > [cipaexpert] > App Configs > Environmental Variables
# ==============================================================================

# 1. AMBIENTE E REDE
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 2. CONEXÃO COM O POSTGRESQL (REDE INTERNA DO CAPROVER)
# Formato padrão da skill CapRover:
DATABASE_URL="postgresql://postgres:SUA_SENHA_FORTE@srv-captain--postgres:5432/cipaexpert?schema=public"

# 3. SEGURANÇA E CRIPTOGRAFIA (OWASP / JWT / BCRYPT)
# Chave secreta de alta entropia para assinatura de tokens JWT (mínimo 32 caracteres)
JWT_SECRET="altere-para-uma-chave-criptografica-muito-segura-e-aleatoria-2026-nr5"

# 4. POLÍTICA DE SESSÃO
TOKEN_EXPIRATION="12h"
BCRYPT_ROUNDS=12
