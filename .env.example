# ==============================================================================
# CIPA EXPERT · VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (CAPROVER / VPS / CONTAINER)
# ==============================================================================
# REGRA DE OURO: NUNCA commite chaves ou senhas reais no repositório.
# Configure estas variáveis no painel do CapRover:
# Apps > [cipaexpert] > App Configs > Environmental Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE E REDE
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (POSTGRESQL / PRISMA ORM)
# ------------------------------------------------------------------------------
# Exemplo rede interna CapRover: postgresql://postgres:SENHA@srv-captain--postgres:5432/cipaexpert?schema=public
DATABASE_URL="postgresql://usuario:senha@host:5432/cipaexpert?schema=public"

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E CRIPTOGRAFIA (OWASP / JWT / BCRYPT)
# ------------------------------------------------------------------------------
JWT_SECRET="gere-uma-chave-criptografica-muito-segura-e-aleatoria-minimo-32-chars"
TOKEN_EXPIRATION="12h"
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (GEMINI & GROQ)
# ------------------------------------------------------------------------------
# Chave da API Google Gemini
GEMINI_API_KEY="AIzaSy..."

# Chave da API Groq (Llama / Mixtral de ultra-baixa latência)
GROQ_API_KEY="gsk_..."

# ------------------------------------------------------------------------------
# 5. SERVIÇO DE E-MAIL (SMTP TRANSACIONAL / ALERTAS CIPA)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notificacoes@cipaexpert.com.br"
SMTP_PASS="senha-smtp-segura"
SMTP_FROM="CIPA Expert <notificacoes@cipaexpert.com.br>"

# ------------------------------------------------------------------------------
# 6. STORAGE DE ARQUIVOS (MINIO / S3 COMPATÍVEL - ATAS, DOCUMENTOS E ASSINATURAS)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT="minio.seudominio.com"
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY="minio-admin-user"
MINIO_SECRET_KEY="minio-admin-secret-password"
MINIO_BUCKET_NAME="cipaexpert-docs"
MINIO_BUCKET_PHOTOS="fotos"
MINIO_PUBLIC_URL=""
